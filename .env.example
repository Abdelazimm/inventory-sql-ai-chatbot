# OpenAI / LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
MODEL_NAME=gpt-4o-mini

# Database Configuration (SQLite by default, or PostgreSQL for production)
DATABASE_URL=sqlite:///./inventory.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/inventory_db

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_change_me_in_production_123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# LangSmith Observability (Optional)
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=inventory-sql-ai-chatbot
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Application Environment & Logging
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
MAX_QUERY_ROWS=100
QUERY_TIMEOUT_SECONDS=10
